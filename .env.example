# Copy to .env (gitignored) and fill in. run.sh loads it automatically.

# uuid of a project you created in the Flow UI (flow.google.com/project/<uuid>)
FLOW_PROJECT_ID=

# Suno API key — only needed for /fk-gen-music
SUNO_API_KEY=

# Python of the OmniVoice TTS venv — only needed for narration
# TTS_PYTHON_BIN=/path/to/tts-venv/bin/python3

# rclone destination for /fk-drive-upload (default gdrive:FlowKit)
# FK_DRIVE_DEST=gdrive:FlowKit
